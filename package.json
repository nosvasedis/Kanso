{
  "name": "kanso",
  "version": "1.0.0",
  "description": "Kanso — clean stream marks for Nuvio. No echo. Every detail once.",
  "type": "module",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.mjs",
    "generate-icons:upload": "node scripts/generate-icons.mjs --upload",
    "generate-icons:lang": "node scripts/generate-icons.mjs --lang-only --upload && node scripts/patch-badges-solid.mjs",
    "solid:icons": "node scripts/build-solid-icons.mjs",
    "solid:icons:upload": "node scripts/build-solid-icons.mjs --upload",
    "solid:patch": "node scripts/patch-badges-solid.mjs",
    "transparent:icons": "node scripts/generate-icons-transparent.mjs",
    "transparent:icons:upload": "node scripts/generate-icons-transparent.mjs --upload",
    "transparent:patch": "node scripts/patch-badges-transparent.mjs",
    "mono:icons": "npm run transparent:icons",
    "mono:icons:upload": "npm run transparent:icons:upload",
    "mono:patch": "node scripts/patch-badges-mono.mjs",
    "patch-badges": "node scripts/patch-badges-solid.mjs",
    "update-badges": "node scripts/patch-badges-solid.mjs",
    "patch-formatter": "node scripts/patch-formatter.mjs",
    "push-gist": "node scripts/push-gist.mjs",
    "audit:gists": "node scripts/audit-gist-drift.mjs",
    "release": "node scripts/patch-badges-all-v2.mjs && node scripts/patch-formatter.mjs && npm run test:formatter && npm run test:v2-parity && npm run test:v2-runtime",
    "release:publish": "npm run release && npm run push-gist -- --require",
    "release:v2": "npm run release",
    "release:v2:publish": "npm run release:publish",
    "badges": "node scripts/generate-icons-transparent.mjs --upload && node scripts/patch-badges-solid.mjs && node scripts/patch-badges-transparent.mjs && node scripts/patch-badges-mono.mjs && node scripts/patch-formatter.mjs",
    "sync": "node scripts/sync-server.mjs",
    "test:tier-sync": "node scripts/test-tier-group-sync.mjs",
    "mono:publish": "npm run transparent:icons:upload && npm run transparent:patch && npm run mono:patch && npm run patch-formatter",
    "mono": "npm run transparent:icons && npm run transparent:patch && npm run mono:patch",
    "publish": "npm run transparent:icons:upload && npm run solid:icons:upload && npm run solid:patch && npm run transparent:patch && npm run mono:patch && npm run patch-formatter",
    "test:formatter": "node scripts/test-formatter-layout.mjs && node scripts/test-formatter-aiostreams-syntax.mjs && node scripts/test-formatter-runtime.mjs",
    "test:formatter-editions": "node scripts/test-formatter-editions.mjs",
    "test:edition-badges": "node scripts/test-edition-badges.mjs",
    "test:quality-badges": "node scripts/test-quality-badges.mjs",
    "test:edition-icons": "node scripts/test-edition-icons.mjs",
    "test:streaming": "node scripts/test-streaming-formatter.mjs",
    "test:streaming-colors": "node scripts/test-streaming-brand-colors.mjs",
    "test:transparent": "node scripts/test-transparent-theme.mjs",
    "test:mono": "node scripts/test-mono-theme.mjs",
    "test:solid": "node scripts/test-solid-theme.mjs",
    "test:solid-icons": "node scripts/test-solid-icon-manifest.mjs",
    "test:solid-dark-icons": "node scripts/test-solid-dark-icons.mjs",
    "test:glass": "npm run test:solid",
    "test:dr": "node scripts/test-dr-inject.mjs && node scripts/test-dr-badges.mjs",
    "test:smart-tier": "node scripts/test-smart-tier.mjs",
    "test:audio-smart-tier": "node scripts/test-audio-smart-tier.mjs",
    "fetch-kingsizew-icons": "node scripts/fetch-kingsizew-icons.mjs",
    "audit:icons": "node scripts/audit-icon-latency.mjs",
    "icons:materialize": "node scripts/materialize-badge-images.mjs",
    "icons:publish": "node scripts/publish-badge-images.mjs",
    "icons:cdn": "npm run icons:materialize && npm run icons:publish",
    "kanso:publish": "node scripts/publish-kanso-repo.mjs",
    "test:sdr": "node scripts/test-sdr-badge.mjs",
    "test:bad-source": "node scripts/test-bad-source-badges.mjs",
    "test:resolution": "node scripts/test-resolution-patterns.mjs",
    "test:v2-parity": "node scripts/test-v2-parity.mjs",
    "test:v2-runtime": "tsx scripts/test-v2-aiostreams-runtime.ts",
    "test:v2-benchmark": "node scripts/test-v2-benchmark.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "sharp": "^0.34.5",
    "tsx": "^4.23.0"
  }
}
