{
  "name": "kanso",
  "version": "2.2.0",
  "description": "Kanso — clean stream marks for Nuvio. No echo. Every detail once.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-presets.mjs",
    "test:setup": "node scripts/setup-test-engine.mjs",
    "test": "npm run test:formatter && npm run test:assets && npm run test:tier-sync",
    "test:formatter": "tsx scripts/test-presets-runtime.ts",
    "test:assets": "node scripts/test-preset-assets.mjs",
    "test:tier-sync": "node scripts/test-tier-group-sync.mjs",
    "release": "npm run build && npm run test:setup && npm test",
    "release:publish": "npm run release && npm run kanso:publish && npm run verify:public -- --repository-only && npm run push-gist -- --require && npm run verify:public",
    "release:v2": "npm run release",
    "release:v2:publish": "npm run release:publish",
    "patch-formatter": "npm run build",
    "patch-badges": "npm run build",
    "update-badges": "npm run build",
    "badges": "npm run build",
    "solid:patch": "npm run build",
    "transparent:patch": "npm run build",
    "mono:patch": "npm run build",
    "push-gist": "node scripts/push-gist.mjs",
    "kanso:publish": "node scripts/publish-kanso-repo.mjs",
    "verify:public": "node scripts/verify-public-release.mjs",
    "audit:gists": "node scripts/audit-gist-drift.mjs",
    "sync": "node scripts/sync-server.mjs",
    "test:v2-runtime": "npm run test:formatter",
    "test:v2-parity": "npm run test:formatter",
    "generate-icons": "npm run build",
    "solid:icons": "npm run build",
    "transparent:icons": "npm run build",
    "mono:icons": "npm run build",
    "publish": "npm run release:publish",
    "mono:publish": "npm run release:publish",
    "mono": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "sharp": "^0.35.5",
    "tsx": "^4.23.0"
  }
}
